<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputType>Package</OutputType>
    <OutputName>dscregd-$(ReleaseVersion)-windows-amd64</OutputName>
    <!-- CI's VERSION environment variable contains a v-prefixed tag, not a NuGet version. -->
    <Version>$(ProductVersion)</Version>
    <DefineConstants>ReleaseVersion=$(ReleaseVersion);ProductVersion=$(ProductVersion);BinaryPath=$(BinaryPath)</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Go emits an unversioned PE; MSI supplies its release file version. -->
    <SuppressSpecificWarnings>1103</SuppressSpecificWarnings>
  </PropertyGroup>
</Project>
